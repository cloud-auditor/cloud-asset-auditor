# Build artifacts
bin/
*.test
*.exe
*.prof
coverage.out
coverage.html

# VCS, CI, IDE, OS
.git/
.github/
.idea/
.vscode/
.DS_Store

# Local credentials / config (must NEVER end up in the image)
auditor.yaml
.auditor.yaml
*.env
*.pem
*.key

# Docs and planning — not needed at build time
*.md
docs/

# Other deploy targets — image build only needs deploy/docker/
deploy/helm/

# Lint config — not needed at build time
.golangci.yml

# Plan / claude / agent state
.claude/

# Frontend source. The Docker build compiles Go only — the web UI is already
# built and committed under internal/server/webui/, which go:embed picks up.
# Shipping web/ (and especially node_modules/) into the build context would
# add tens of MB and slow every layer for files the build never reads.
web/node_modules/
web/.next/
web/out/
